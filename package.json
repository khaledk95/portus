{
  "name": "portus",
  "version": "1.3.1",
  "description": "Cross-platform AWS SSM & RDP-over-SSM access tool",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:win64": "electron-builder --win --x64",
    "build:win32": "electron-builder --win --ia32",
    "build:mac": "electron-builder --mac",
    "build:mac-intel": "electron-builder --mac --x64",
    "build:mac-silicon": "electron-builder --mac --arm64",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish=never",
    "dist:mac": "electron-builder --mac --publish=never",
    "release": "electron-builder --publish=always",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "aws",
    "ssm",
    "rdp",
    "electron",
    "azure",
    "cloud",
    "ec2",
    "session-manager"
  ],
  "author": "khaledk95",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.1.0",
    "electron-builder": "^24.6.4"
  },
  "optionalDependencies": {
    "dmg-license": "^1.0.11"
  },
  "dependencies": {
    "@aws-sdk/client-ec2": "^3.450.0",
    "@aws-sdk/client-ssm": "^3.1098.0",
    "@aws-sdk/credential-providers": "^3.450.0",
    "fs-extra": "^11.1.1",
    "ini": "^4.1.1"
  },
  "build": {
    "appId": "io.github.khaledk95.portus",
    "productName": "Portus",
    "copyright": "Copyright © 2025 Portus contributors",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json",
      ".env",
      "!node_modules/.cache",
      "!**/*.ts",
      "!**/*.map",
      "!.github/**/*",
      "!.git/**/*",
      "!README.md",
      "!.gitignore"
    ],
    "extraResources": [
      {
        "from": "build/",
        "to": "build/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/portus.ico",
      "publisherName": "Portus",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Portus"
    },
    "portable": {
      "artifactName": "Portus-Portable-${version}-${arch}.exe"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "build/portus.png",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "darkModeSupport": true,
      "minimumSystemVersion": "10.15.0",
      "type": "distribution"
    },
    "dmg": {
      "title": "${productName} ${version}",
      "iconSize": 80,
      "window": {
        "width": 540,
        "height": 380
      },
      "backgroundColor": "#ffffff",
      "internetEnabled": false,
      "sign": false,
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "rpm",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "tar.gz",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/portus.png",
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "desktop": {
        "Name": "Portus",
        "Comment": "Secure SSM & RDP-over-SSM access for AWS instances",
        "Keywords": "AWS;Cloud;SSM;RDP;SessionManager;",
        "StartupWMClass": "portus"
      }
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "synopsis": "Secure SSM & RDP-over-SSM access for AWS instances",
      "description": "Connect to EC2 instances via AWS Systems Manager Session Manager (SSM) shell and RDP-over-SSM tunneling, with Azure AD SSO authentication.",
      "category": "Development",
      "priority": "optional",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "rpm": {
      "synopsis": "Secure SSM & RDP-over-SSM access for AWS instances",
      "description": "Connect to EC2 instances via AWS Systems Manager Session Manager (SSM) shell and RDP-over-SSM tunneling, with Azure AD SSO authentication.",
      "category": "Development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "snap": {
      "synopsis": "Secure SSM & RDP-over-SSM access for AWS instances",
      "description": "Connect to EC2 instances via AWS Systems Manager Session Manager (SSM) shell and RDP-over-SSM tunneling, with Azure AD SSO authentication.",
      "category": "development",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "compression": "maximum",
    "removePackageScripts": true,
    "removePackageKeywords": true,
    "electronVersion": "37.1.0",
    "buildVersion": "1.3.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/khaledk95/portus.git"
  },
  "bugs": {
    "url": "https://github.com/khaledk95/portus/issues"
  },
  "homepage": "https://github.com/khaledk95/portus#readme"
}
